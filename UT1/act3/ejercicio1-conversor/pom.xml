<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.ies.puerto.diagramas</groupId>
    <artifactId>ejercicio1-conversor</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.0</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
    <profile>
        <id>nota</id>

        <build>
            <plugins>

                <!--
                    En modo autocorrección los tests fallidos NO detienen Maven.
                    Los resultados quedan igualmente en surefire-reports.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>

                    <configuration>
                        <useModulePath>false</useModulePath>

                        <!-- Fundamental para poder calcular la nota -->
                        <testFailureIgnore>true</testFailureIgnore>
                    </configuration>
                </plugin>


                <!-- Calcula la nota después de ejecutar los tests -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>

                    <executions>
                        <execution>
                            <id>calcular-nota</id>

                            <phase>verify</phase>

                            <goals>
                                <goal>exec</goal>
                            </goals>

                            <configuration>
                                <executable>python3</executable>

                                <arguments>
                                    <argument>
                                        ${project.basedir}/calcular_nota.py
                                    </argument>
                                </arguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

            </plugins>
        </build>
    </profile>
</profiles>
</project>
